# Copy this file to `.env` and fill in the key.
# `.env` is gitignored. This example file is safe to commit — it has no secrets.

# Your Anthropic API key. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Which model the pipeline uses. Cheaper options exist if cost matters:
#   claude-opus-5-5   $4 / $20 per million tokens  (default, most capable)
#   claude-sonnet-5-5 $2 / $10 per million tokens
#   claude-haiku-5-5  $0.10 / $0.50 per million tokens
# One topic costs a fraction of a cent on any of them.
AI_MODEL=claude-opus-5-5
