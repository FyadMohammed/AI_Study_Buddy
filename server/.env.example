# Copy this file to `.env` and fill in the key.
# `.env` is gitignored. This example file is safe to commit — it has no secrets.
#
# ONE file, read by BOTH halves of the server:
#   - Python reads it through load_dotenv() in ai/model.py
#   - Node reads it through the --env-file-if-exists flag in package.json
#     (so `npm start` picks it up; plain `node index.js` does NOT)

# ── Python AI service ─────────────────────────────────────────────────
# Your Anthropic API key. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Which model the pipeline uses. Cheaper options exist if cost matters:
#   claude-opus-5-5   $4 / $20 per million tokens  (default, most capable)
#   claude-sonnet-5-5 $2 / $10 per million tokens
#   claude-haiku-5-5  $0.10 / $0.50 per million tokens
# One topic costs a fraction of a cent on any of them.
AI_MODEL=claude-opus-5-5

# ── Express server ────────────────────────────────────────────────────
# true  = use mockAiService (hard-coded strings, no key, no Python needed)
# false = call the Python service for real
USE_MOCK_AI=false

# Where the Python service listens. Only change if you moved the port.
AI_SERVICE_URL=http://localhost:8001

# Port for Express itself. The Vue client expects 3000.
PORT=3000
